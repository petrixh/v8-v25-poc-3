{
  "loginPath": "/UI/login",
  "login": {
    "user": "#login-username",
    "password": "#login-password",
    "submit": "#login-signin"
  },
  "loggedInSelector": ".valo-menu-item",
  "navSelector": ".valo-menu-item:not(.v-csslayout)",
  "settleMs": 3000,
  "maxScrollFactor": 4,
  "exactNav": false,
  "users": [
    {
      "name": "admin",
      "username": "admin",
      "passwordFile": "~/.config/mig-ci/test-users.env",
      "passwordKey": "MIG_TU_ADMIN_PW",
      "views": [
        "Rollout",
        "Target Filters",
        "Distributions",
        "Upload",
        "System Config",
        "Deployment"
      ]
    },
    {
      "name": "readonly",
      "username": "readonly",
      "passwordFile": "~/.config/mig-ci/test-users.env",
      "passwordKey": "MIG_TU_READONLY_PW",
      "views": [
        "Rollout",
        "Target Filters",
        "Distributions",
        "Upload",
        "Deployment"
      ]
    },
    {
      "name": "targets",
      "username": "targets",
      "passwordFile": "~/.config/mig-ci/test-users.env",
      "passwordKey": "MIG_TU_TARGETS_PW",
      "views": [
        "Target Filters",
        "Deployment"
      ]
    },
    {
      "name": "repository",
      "username": "repository",
      "passwordFile": "~/.config/mig-ci/test-users.env",
      "passwordKey": "MIG_TU_REPOSITORY_PW",
      "views": [
        "Distributions",
        "Upload",
        "Deployment"
      ]
    }
  ]
}
