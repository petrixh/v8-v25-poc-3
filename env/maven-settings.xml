<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for the env image build (env/up.sh), passed with -s unless APP_ENV_MAVEN_SETTINGS names another
  file. Sends every repository, including ones declared in the project's or in transitive POMs, to Maven Central,
  except the Vaadin add-ons repository. up.sh fails the build if Maven downloaded from any other host.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>vaadin-addons-direct</id>
      <mirrorOf>vaadin-addons</mirrorOf>
      <url>https://maven.vaadin.com/vaadin-addons</url>
    </mirror>
    <mirror>
      <id>central-only</id>
      <mirrorOf>*,!vaadin-addons</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
